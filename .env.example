# =========================================================================
# SharedPlaylist Environment
# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it's already in .gitignore.
# =========================================================================

# ---- Phase 1 app runtime ----
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
API_INTERNAL_BASE_URL=http://127.0.0.1:4000

DATABASE_URL=postgresql://sharedplaylist:sharedplaylist@127.0.0.1:5432/sharedplaylist?schema=public
REDIS_URL=redis://127.0.0.1:6379

# 32-byte base64 key for AES-256-GCM token encryption.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Enables YouTube provider routes and worker code paths.
YOUTUBE_BETA_ENABLED=false

# ---- Spotify ----
# Created at https://developer.spotify.com/dashboard
# Redirect URI in your Spotify app must EXACTLY match SPOTIFY_REDIRECT_URI below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# The Spotify playlist ID you'll add songs to during the smoke test.
# After running `pnpm smoke:list-playlists` you'll see the IDs of your playlists.
SPOTIFY_SOURCE_PLAYLIST_ID=

# ---- Apple Music ----
# Created at https://developer.apple.com/account → Keys (with MusicKit capability)
# Team ID is shown at the top-right of your developer.apple.com account.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_HOST_PATH=./AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_music_private_key.p8

# Your Apple Music storefront (usually 'us', 'gb', 'jp', etc.)
APPLE_STOREFRONT=us

# The Apple Music library playlist ID to sync TO.
# After running `pnpm smoke:auth:apple` and `pnpm smoke:list-playlists`,
# you'll see the IDs of your library playlists.
APPLE_TARGET_PLAYLIST_ID=

# ---- Google / YouTube beta ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/v1/connections/youtube/callback

# ---- Sync ----
# How often to poll Spotify for changes (in seconds)
POLL_INTERVAL_SECONDS=30
SYNC_ACTIVE_INTERVAL_SECONDS=30
SYNC_IDLE_INTERVAL_SECONDS=300

# Where to store the SQLite state file
STATE_DIR=./smoke/state
